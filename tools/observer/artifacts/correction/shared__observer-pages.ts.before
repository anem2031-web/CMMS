export function findObserverPage(
  path: string
): { page: ObserverPage; parameter?: string | number } | null {
  const pathname = path.split(/[?#]/, 1)[0].replace(/\/$/, "") || "/";
  const segments = pathname.split("/");
  for (const entry of OBSERVER_PAGES) {
    const parts = entry.path.split("/");
    if (parts.length !== segments.length) continue;
    let parameter: string | number | undefined,
      matches = true;
    for (let i = 0; i < parts.length; i++) {
      if (!parts[i].startsWith(":")) {
        if (parts[i] !== segments[i]) matches = false;
        continue;
      }
      let value: string;
      try {
        value = decodeURIComponent(segments[i]);
      } catch {
        matches = false;
        break;
      }
      if (!value || value.length > 100 || /[\\/\u0000-\u001f]/.test(value)) {
        matches = false;
        break;
      }
      if (parts[i] === ":id") {
        if (!/^[1-9]\d*$/.test(value) || Number(value) > 2147483647) {
          matches = false;
          break;
        }
        parameter = Number(value);
      } else parameter = value;
    }
    if (matches) return { page: entry, parameter };
  }
  return null;
}

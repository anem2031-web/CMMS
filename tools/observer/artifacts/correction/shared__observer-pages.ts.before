/** Explicit page/data-source registry. Paths never become table names or SQL. */
export type ObserverDataset = { source: string; filter?: string };
export type ObserverPage = {
  path: string;
  title: string;
  datasets: ObserverDataset[];
};
const page = (
  path: string,
  title: string,
  sources: string[],
  filter?: string
): ObserverPage => ({
  path,
  title,
  datasets: sources.map((source, index) => ({
    source,
    ...(index === 0 && filter ? { filter } : {}),
  })),
});

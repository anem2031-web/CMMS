import { useEffect, useState } from "react";
import { useLocation } from "wouter";
import { trpc } from "@/lib/trpc";
import { useTranslation } from "@/contexts/LanguageContext";
import { findObserverPage } from "@shared/observer-pages";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { Eye, ChevronLeft, ChevronRight, RefreshCw } from "lucide-react";

const labels: Record<string, string> = {
  tickets: "التذاكر",
  ticketItems: "بنود التذاكر",
  ticketDepartments: "الجهات",
  ticketTasks: "المهام",
  ticketStatusHistory: "سجل الحالات",
  inspectionResults: "الفحوصات",
  users: "المستخدمون",
  sites: "المواقع",
  sections: "الأقسام",
  technicians: "الفنيون",
  purchaseOrders: "طلبات الشراء",
  purchaseOrderItems: "أصناف الشراء",
  purchaseOrderItemHistory: "سجل الأصناف",
  purchasePackages: "حزم الشراء",
  purchasePackageSubmissions: "إرسالات الحزم",
  assets: "الأصول",
  assetCategories: "تصنيفات الأصول",
  assetMetrics: "المؤشرات",
  assetSpareParts: "قطع الغيار",
  inventory: "رصيد المخزون",
  inventoryLots: "الدفعات",
  inventoryLotBalances: "أرصدة الدفعات",
  inventoryTransactions: "الحركات",
  inventoryIssueCostAllocations: "توزيع التكلفة",
  inventoryCountOperations: "الجرد",
  inventorySettlements: "التسويات",
  disposalOperations: "الاستبعاد",
  warehouseReceipts: "سندات الاستلام",
  warehouseReceiptItems: "بنود الاستلام",
  deliveryDocuments: "سندات الصرف",
  returnDocuments: "سندات الإرجاع",
  warehouseReturns: "المرتجعات",
  warehouses: "المستودعات",
  warehouseTransferBatches: "عمليات التحويل",
  warehouseTransfers: "بنود التحويل",
  warehouseIssueBatches: "عمليات الصرف",
  warehouseIssueBatchItems: "بنود الصرف",
  externalMaintenanceJobs: "الصيانة الخارجية",
  improvementIdeas: "أفكار التحسين",
  notifications: "الإشعارات",
  auditLogs: "التدقيق",
  backups: "النسخ الاحتياطية",
  aiResponseCache: "المحادثات المحفوظة",
  translationJobs: "مهام الترجمة",
  entityTranslations: "الترجمات",
  translationVersions: "إصدارات الترجمة",
  centerCategories: "التصنيفات المركزية",
  maintenance_teams: "فرق الصيانة",
  maintenance_team_members: "أعضاء الفرق",
  ticket_team_assignments: "إسنادات التذاكر",
  ticket_team_material_needs: "احتياجات المواد",
  ticket_team_actions: "إجراءات الفريق",
  ticket_team_supply_links: "التوفير",
  ticket_team_delivery_links: "الصرف للفني",
  ticket_team_return_links: "مرتجعات الفريق",
  pmv2Programs: "برامج الصيانة",
  pmv2ProgramTargets: "أهداف البرامج",
  pmv2Teams: "فرق PMV2",
  pmv2TeamMembers: "أعضاء PMV2",
  pmv2Checklists: "قوائم الفحص",
  pmv2ChecklistItems: "بنود الفحص",
  pmv2SlaRules: "مدد الإجراءات",
  pmv2Tasks: "المهام المجدولة",
  pmv2TaskItems: "بنود المهام",
  pmv2Visits: "الزيارات",
  pmv2ItemActions: "إجراءات الفني",
  pmv2MaterialRequests: "طلبات المواد",
  pmv2MaterialRequestItems: "مواد الطلبات",
  pmv2MaterialPurchaseLinks: "الشراء المرتبط",
  pmv2DailyReportReviews: "مراجعات التقارير",
  preventivePlans: "الخطط الوقائية",
  pmMainPlans: "الخطط الرئيسية",
  pmSubPlans: "الخطط الفرعية",
  pmWorkOrders: "أوامر العمل",
  pmExecutionResults: "نتائج التنفيذ",
  constructionProjects: "المشاريع",
  constructionTasks: "مهام الإنشاءات",
  constructionDailyReports: "التقارير اليومية",
  constructionGoals: "الأهداف",
  constructionPhases: "المراحل",
  constructionChangeOrders: "أوامر التغيير",
  constructionQuantityTracking: "تتبع الكميات",
  catalogItems: "الأصناف",
  catalogNodes: "تصنيفات الكتالوج",
  catalogUnits: "الوحدات",

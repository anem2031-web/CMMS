  "external:waiting_gate_entry": ["بانتظار الدخول من البوابة", "Awaiting gate entry", "گیٹ میں داخلے کا انتظار"],
  "external:waiting_warehouse_receipt": ["بانتظار استلام الأصل في المستودع", "Awaiting warehouse asset receipt", "مستودع میں اثاثے کی وصولی کا انتظار"],
  "external:waiting_technician_handover": ["بانتظار التسليم لإعادة التركيب", "Awaiting reinstallation handover", "دوبارہ تنصیب کے لیے حوالگی کا انتظار"],
  "external:delivered_for_reinstall": ["تم التسليم لإعادة التركيب", "Handed over for reinstallation", "دوبارہ تنصیب کے لیے حوالے"],
  "external:reinstall_in_progress": ["إعادة التركيب جارية", "Reinstallation in progress", "دوبارہ تنصیب جاری"],
  "external:ready_for_closure": ["بانتظار إغلاق الصيانة الخارجية", "External maintenance ready for closure", "بیرونی دیکھ بھال کی بندش کا انتظار"],
};
export function dashboardStageLabel(language: string, value: string | null): string | null {
  if (!value) return null;
  const index = language === "en" ? 1 : language === "ur" ? 2 : 0;
  const labels = value.split("|").flatMap(key => stages[key] ? [stages[key][index]] : []);
  return labels.join(" · ") || null;
}
